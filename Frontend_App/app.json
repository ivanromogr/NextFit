{
  "expo": {
    "name": "NextFit",
    "slug": "Frontend_App",
    "scheme": "nextfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-nextfit.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/logo-nextfit.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.iviromo.nextfit"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-nextfit.png",
        "backgroundColor": "#09090b"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.iviromo.Frontend_App"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "NextFit usa las fotos y los vídeos que elijas para tu perfil o para compartirlos en el chat.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1863df44-2f81-450b-b39c-c358a1390d2f"
      }
    }
  }
}
